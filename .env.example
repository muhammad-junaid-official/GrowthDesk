# GrowthDesk - Full-Stack Production-Grade SEO Suite & AI Assistant
# Environment Configuration

# 1. DataForSEO API (DataForSEO v3 REST API)
# Register at https://dataforseo.com to obtain credentials
DATAFORSEO_LOGIN="your_dataforseo_email@domain.com"
DATAFORSEO_PASSWORD="your_dataforseo_api_password"

# 2. Google PageSpeed Insights API
# Free API key from Google Cloud Console:
# https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY="AIzaSyYourGoogleApiKeyHere"

# 3. OpenAI API (for AI Assistant Chatbot with GPT-4o-mini)
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-yourOpenAiApiKeyHere"

# 4. App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
